<Window x:Class="ScContractTracker.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ScContractTracker.App.Services"
        Style="{StaticResource WindowStyle}"
        Title="{svc:Tr About.Title}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Style="{StaticResource Panel}" Margin="12">
    <StackPanel Margin="8">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/app.ico" Width="56" Height="56" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{svc:Tr App.Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{svc:Tr About.Description}" TextWrapping="Wrap" Margin="0,18,0,0" />
        <TextBlock Text="{svc:Tr About.Disclaimer}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />

        <TextBlock Style="{StaticResource SectionLabel}" Text="GitHub" Margin="0,18,0,2" />
        <Button x:Name="RepoLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Repo_Click" />

        <TextBlock Style="{StaticResource SectionLabel}" Text="{svc:Tr About.DataFolder}" Margin="0,12,0,2" />
        <Button x:Name="DataLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Data_Click" />

        <TextBlock Style="{StaticResource SectionLabel}" Text="{svc:Tr About.Support}" Margin="0,12,0,2" />
        <TextBlock Text="{svc:Tr About.SupportNote}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" />
        <Button x:Name="SupportLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Support_Click" Margin="0,2,0,0" />

        <TextBlock Text="© 2026 Jiří Libich · MIT License" Style="{StaticResource Muted}" FontSize="11" Margin="0,18,0,0" />

        <Button Content="{svc:Tr About.Close}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,16,0,0" />
    </StackPanel>
    </Border>
</Window>
