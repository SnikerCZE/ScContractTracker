<Window x:Class="ScContractTracker.App.Views.ContractEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ScContractTracker.App.Services"
        Style="{StaticResource WindowStyle}"
        Title="{svc:Tr Edit.Title}"
        Width="820" Height="780" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Style="{StaticResource Panel}" Margin="12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="420" />
                <Button Content="{svc:Tr Settings.Save}" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click" MinWidth="90" />
                <Button Content="{svc:Tr Settings.Cancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="90" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="4,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Název přes celou šířku -->
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="TitleBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Type}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <ComboBox x:Name="TypeBox" DisplayMemberPath="Value" SelectedValuePath="Key" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Status}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <ComboBox x:Name="StatusBox" DisplayMemberPath="Value" SelectedValuePath="Key" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Giver}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="GiverBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Person}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="PersonBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Accepted}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="AcceptedBox" ToolTip="yyyy-MM-dd HH:mm:ss" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Finished}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="FinishedBox" ToolTip="yyyy-MM-dd HH:mm:ss" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Reward}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="RewardBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.Fee}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="FeeBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Edit.Rep}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <DockPanel>
                            <TextBox x:Name="RepMinBox" Width="110" />
                            <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center" />
                            <TextBox x:Name="RepMaxBox" Width="110" HorizontalAlignment="Left" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Mode.Label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <ComboBox x:Name="ModeBox" DisplayMemberPath="Value" SelectedValuePath="Key" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Active.Details}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Active.Objectives}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="ObjectivesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="{svc:Tr Edit.ObjectivesHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="8" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Col.BpReceived}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="BlueprintsBox" AcceptsReturn="True" MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                    <StackPanel Grid.Row="8" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="{svc:Tr Rewards.Items}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="ItemsBox" AcceptsReturn="True" MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                    <TextBlock Grid.Row="9" Grid.ColumnSpan="3" Text="{svc:Tr Edit.ListHint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
